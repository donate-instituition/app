# Não controla a baseURL local (isso agora é hardcoded em src/config/environments.ts,
# troque CURRENT_ENVIRONMENT lá). Só é usado por eas.json para forçar HOMOLOGA/PROD em
# builds com profile preview/production, mesmo que o hardcoded local esteja desatualizado.
EXPO_PUBLIC_APP_ENV=local
EXPO_PUBLIC_LOG_LEVEL=debug
EXPO_PUBLIC_SUPPORT_EMAIL=contato@elodoar.local
EXPO_PUBLIC_SUPPORT_WHATSAPP=5581999999999
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Web-type OAuth 2.0 Client ID from Google Cloud Console — same value the
# backend's GOOGLE_WEB_CLIENT_ID must have.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

EXPO_PUBLIC_DEV_DONOR_EMAIL=dev.doador@elodoar.local
EXPO_PUBLIC_DEV_DONOR_PASSWORD=12345678

EXPO_PUBLIC_DEV_INSTITUTION_EMAIL=dev.instituicao@elodoar.local
EXPO_PUBLIC_DEV_INSTITUTION_PASSWORD=12345678

EXPO_PUBLIC_DEV_ADMIN_EMAIL=dev.admin@elodoar.local
EXPO_PUBLIC_DEV_ADMIN_PASSWORD=12345678
